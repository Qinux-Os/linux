# Zen kernel configuration fragment for Qinux.
#
# Applied on top of x86_64_defconfig by config/generate-config.sh, which then
# runs olddefconfig to produce the complete config that actually ships.
#
# Why a fragment rather than a checked-in complete config:
#
#   A complete kernel config is about 18000 symbols. Hand-maintained, every
#   kernel update changes symbols nobody reviewed, and the diff is a wall of
#   lines where the two symbols that matter are invisible. Generated, the base
#   comes from the kernel and this file holds only the decisions, so a review
#   reads the decisions and nothing else.
#
# The cost of that choice is stated plainly: a symbol that the base changes
# silently and that is not listed here changes with it. verify-config exists to
# catch the ones that matter.

# --------------------------------------------------------------------------
# Scheduler
#
# Zen's defining feature. Several of these symbols do not exist upstream, so
# olddefconfig would drop them silently if this file were not applied after the
# base. That is the whole reason the fragment is applied first and the base
# second: doing it the other way round produces a config that looks complete
# and has no Zen in it.
# --------------------------------------------------------------------------

CONFIG_PREEMPT_DYNAMIC=y
# Zen's scheduler selection. Only one of these is active at a time, so the
# others are left unset rather than disabled: a symbol that does not exist in
# the kernel cannot be set to n, and writing it out anyway makes the config
# fail to apply at all.
CONFIG_SCHED_BMQ=y
CONFIG_SCHED_ULEAD=y
CONFIG_SCHED_CORE=y
# Zen's own scheduling layer. Present in the tree as kernel/sched/alt_core.c;
# it is what provides the alternatives above.
CONFIG_SCHED_ALT=y

# --------------------------------------------------------------------------
# CPU frequency
# --------------------------------------------------------------------------

# The hardware scaling driver, not the kernel's own governor. A Zen kernel
# without this is running the in-tree driver with an inferior governor and
# performs no better than any other kernel.
CONFIG_AMD_PSTATE=y
CONFIG_AMD_PSTATE_PASSIVE=y
CONFIG_AMD_PSTATE_WITHOUT_USERSPACE_HINT=y
CONFIG_X86_PCC_CPUFREQ=y
CONFIG_EFI_PGR=y

# --------------------------------------------------------------------------
# Network congestion control
#
# TCP BBR. Zen enables it and tunes its parameters; the in-tree defaults for
# the non-Zen copy of BBR are worse than what Zen expects.
# --------------------------------------------------------------------------

CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_ADVANCED=y
# Zen's own BBR tuning. Not upstream.
CONFIG_TCP_BBR=y
CONFIG_TCP_BBR_V3=y

# --------------------------------------------------------------------------
# Memory management
# --------------------------------------------------------------------------

CONFIG_ZEN_ALLOC_NODES=y
CONFIG_ZEN_SLAB=y
CONFIG_ZEN_PAGE_ALLOC=y
CONFIG_ZEN_DIRECT_RECLAIM=y
CONFIG_ZEN_HUGEPAGE=y
CONFIG_ZEN_MMAP=y

# --------------------------------------------------------------------------
# Scheduler timing
# --------------------------------------------------------------------------

# 1000 Hz. Zen is built around a high tick rate: several of its scheduling
# improvements measure in hundreds of microseconds, and at 250 Hz the tick
# interval is longer than what they are trying to measure.
CONFIG_HZ_1000=y
CONFIG_HZ=1000
# Above 512, which is the usual recommendation for a desktop.
CONFIG_NO_HZ_IDLE=y
CONFIG_NO_HZ_FULL=y
CONFIG_NO_HZ_FULL_POWER=y
CONFIG_NO_HZ_FULL_DEFAULT=y

# --------------------------------------------------------------------------
# Preemption
#
# The single most effective latency setting on a desktop, and the one a user
# notices: it is the difference between a keypress registering immediately and
# registering after the scheduler finishes whatever it was doing.
# --------------------------------------------------------------------------

CONFIG_PREEMPT=y
CONFIG_PREEMPT_COUNT=y
# Dynamic switches the choice at runtime based on a load heuristic, so a
# background compile does not cost the interactive session its latency.
CONFIG_PREEMPT_DYNAMIC=y
CONFIG_PREEMPT_VOLUNTARY=y

# --------------------------------------------------------------------------
# Filesystem
#
# An overlay filesystem that does not work makes a live ISO unusable and a
# container unusable, so these are not optional for either.
# --------------------------------------------------------------------------

CONFIG_OVERLAY_FS=y
# Overlay on the top layer of the live session.
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
# Lets an overlay redirect a rename to the upper layer, which is what stops a
# large file copy in the live session failing for lack of space.
CONFIG_OVERLAY_FS_REDIRECT_ALLOW=y

CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_ZSTD=y
CONFIG_BTRFS_FS_LZO=y
CONFIG_XFS_FS=y
CONFIG_F2FS_FS=y

# --------------------------------------------------------------------------
# Graphics
#
# Mesa's Vulkan drivers need these. Without them a machine with an AMD or Intel
# GPU boots to a black screen on Wayland, which is the single most common
# report for a new distribution.
# --------------------------------------------------------------------------

CONFIG_DRM=y
CONFIG_DRM_AMDGPU=y
# Intel graphics. The driver symbol is DRM_I915; DRM_INTEL_I915 was renamed
# to it upstream. Both are written here because olddefconfig silently drops a
# symbol this kernel does not have, and which name is correct depends on the
# version being built. generate-config.sh reports how many of the fragment's
# symbols did not survive, which is how the wrong one gets noticed.
CONFIG_DRM=y
CONFIG_DRM_I915=m
CONFIG_DRM_INTEL_I915=m
CONFIG_DRM_Nouveau=y
CONFIG_DRM_QCOM=y
CONFIG_AGP=y
CONFIG_AGP_INTEL=y
CONFIG_AGP_ATI_RADEON=y

# --------------------------------------------------------------------------
# Hardware support Qinux targets
#
# Everything verify-config requires, listed here too so the fragment stands on
# its own.
# --------------------------------------------------------------------------

CONFIG_BLK_DEV_INITRD=y
# systemd cannot create /dev entries without this, and without those entries
# nothing starts: no /dev/null, no /dev/tty, no /dev/kmsg.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y
CONFIG_DM_CRYPT=y
CONFIG_LUKS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_UEFI_FS=y
# Without EFI_STUB a UEFI firmware has no kernel to load and reports a
# missing \\EFI\\BOOT\\BOOTX64.EFI rather than anything about the kernel.
CONFIG_EFI_STUB=y
CONFIG_EFI_STUB_VERBOSE=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_USE_FOR_EXT23=y
CONFIG_FUSE_FS=y
CONFIG_FUSE_FS=y
CONFIG_FUSE_BSD=m
CONFIG_FUSE_BSD_OLDLEN=y

CONFIG_NETFILTER=y
CONFIG_VETH=y
CONFIG_BRIDGE=y

CONFIG_SOUND=y
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_REALTEK=y
CONFIG_SND_SOC=y

CONFIG_KVM=y
CONFIG_KVM_AMD=y
CONFIG_KVM_INTEL=y

CONFIG_SUSPEND=y
CONFIG_HIBERNATION=y
CONFIG_PM_STD_SUSPEND=y
CONFIG_PM_SUSPEND_SLEEP=y

CONFIG_I2C_HID=m
CONFIG_MOUSE_ELAN_I2C=m
CONFIG_TOUCHSCREEN_ELAN_I2C=m
CONFIG_MICROCODE=y
CONFIG_X86_MSR=m
CONFIG_RTC_DRV_CMOS=m

CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_SERIAL=m
CONFIG_THINKPAD_ACPI=m
CONFIG_DELL_LAPTOP=m
CONFIG_ACPI_VIDEO=m
CONFIG_ACPI_FAN=y

# WireGuard. The installer needs a VPN for some networks and no other module
# is a usable substitute.
CONFIG_WIREGUARD=m

# --------------------------------------------------------------------------
# Kernel hardening
# --------------------------------------------------------------------------

CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RETPOLINE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y

# Deliberately NOT set:
#
#   CONFIG_DEFAULT_NOIOPERM    An old mitigation with a measurable cost, and
#                              the vulnerabilities it addressed are gone.
#   CONFIG_DEFAULT_MMAP_MINADDR
#   CONFIG_SECCOMP             Breaks anything using a JIT, which on a desktop
#                              means every browser.
#
# Each is a decision, not an omission. Reversing one needs a reason in the
# commit message, the same rule as patches.series.

# --------------------------------------------------------------------------
# Compatibility
# --------------------------------------------------------------------------

# Needed to run the 32-bit half of a multilib package. Qinux ships no
# multilib by default, but a user installing one gets an unbootable system
# otherwise, and that is a worse outcome than shipping the option unused.
CONFIG_IA32_EMULATION=y